{
  "name": "convertize-notifications",
  "version": "1.0.0",
  "repository": "git@github.com:Convertize/notifications.git",
  "author": "Convertize E-Commerce",
  "license": "MIT",
  "homepage": "https://www.convertize.com.br/",
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "mjml": "^4.13.0",
    "npm-run-all": "^4.1.5"
  },
  "scripts": {
    "build": "mjml -c.useMjmlConfigOptions -c.beautify false -l skip \"source/*.mjml\" -o ./compiled",
    "build-beautify": "mjml -c.useMjmlConfigOptions -c.beautify true -l skip \"source/*.mjml\" -o ./compiled",
    "watch:mjml": "mjml -c.useMjmlConfigOptions -c.beautify false -l skip --watch \"source/*.mjml\" -o ./compiled",
    "serve": "browser-sync start --server './compiled' --files './compiled/*.html' --directory",
    "dev": "npm-run-all --parallel watch:mjml serve"
  }
}
